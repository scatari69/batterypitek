# --- Учётные данные Tuya IoT Platform (https://iot.tuya.com) ---
# Общие для всех устройств одного аккаунта.
# Cloud -> Development -> ваш проект -> Overview
TUYA_ACCESS_ID=your_access_id
TUYA_ACCESS_KEY=your_access_secret

# Регион дата-центра (должен совпадать с регионом вашего аккаунта Smart Life / Tuya):
#   Центральная Европа : https://openapi.tuyaeu.com
#   Западная Америка   : https://openapi.tuyaus.com
#   Восточная Америка  : https://openapi-ueaz.tuyaus.com
#   Китай              : https://openapi.tuyacn.com
#   Индия              : https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# --- Список устройств ---
# Основной способ: файл config/devices.yml (см. config/devices.yml.example) —
# id + имя для каждой батареи. Путь можно переопределить:
DEVICES_CONFIG=/config/devices.yml

# Резервный способ для ОДНОГО устройства (если файла списка нет):
# TUYA_DEVICE_ID=your_device_id
# TUYA_DEVICE_NAME=Батарея

# Интервал опроса устройств (секунды)
POLL_INTERVAL=10

# Демо-режим: true — показывать сгенерированные данные без обращения к Tuya.
DEMO_MODE=false
